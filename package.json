{
  "name": "algo-amigo-event-site",
  "version": "1.1.0",
  "private": true,
  "description": "A responsive multi-page event website with GitHub API search and an Express RSVP backend.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js && node --check public/app.js",
    "format": "prettier --write \"server.js\" \"public/**/*.{js,css,html}\" \"*.json\" \"README.md\"",
    "format:check": "prettier --check \"server.js\" \"public/**/*.{js,css,html}\" \"*.json\" \"README.md\""
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  }
}
